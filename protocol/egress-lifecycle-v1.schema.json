{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maelys.dev/schemas/egress-lifecycle-v1.schema.json",
  "title": "Maelys Egress daemon lifecycle event",
  "type": "object",
  "required": ["schemaVersion", "contract", "event"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "maelys-egress-lifecycle/1" },
    "event": {
      "enum": [
        "ready",
        "policy-reloaded",
        "policy-reload-rejected",
        "receipt",
        "stopping",
        "stopped",
        "fatal"
      ]
    },
    "message": { "type": "string" },
    "proxy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["transport", "host", "port"],
          "properties": {
            "transport": { "const": "tcp" },
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["transport", "path"],
          "properties": {
            "transport": { "const": "unix" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "channel": {
      "type": "object",
      "required": ["transport", "path", "protocol"],
      "properties": {
        "transport": { "const": "unix" },
        "path": { "type": "string", "minLength": 1, "pattern": "^/" },
        "protocol": { "const": "maelys-egress-channel-bootstrap/1" }
      },
      "additionalProperties": false
    },
    "admin": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          },
          "additionalProperties": false
        }
      ]
    },
    "policy": {
      "type": "object",
      "required": ["generation", "digest"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {
          "description": "The pinned address the upstream connection was established to, in the numeric form inet_ntop writes (93.184.216.34, 2001:db8::1), without port, scope identifier or brackets. Empty when no upstream connection was established: a request refused by the policy or a quota, or an upstream that refused every pinned address. Since 0.34.0.",
          "type": "string",
          "$comment": "Empty, an IPv4 address in dotted decimal without leading zeros, or an IPv6 address as RFC 5952 writes it and inet_ntop produces it: lower-case groups without leading zeros, at most one ::, optionally ending in dotted decimal. tools/check_schemas.py holds the accepted and refused forms.",
          "pattern": "^(|(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){7}(0|[1-9a-f][0-9a-f]{0,3})|((0|[1-9a-f][0-9a-f]{0,3}):){1,7}:|((0|[1-9a-f][0-9a-f]{0,3}):){1,6}:(0|[1-9a-f][0-9a-f]{0,3})|((0|[1-9a-f][0-9a-f]{0,3}):){1,5}(:(0|[1-9a-f][0-9a-f]{0,3})){1,2}|((0|[1-9a-f][0-9a-f]{0,3}):){1,4}(:(0|[1-9a-f][0-9a-f]{0,3})){1,3}|((0|[1-9a-f][0-9a-f]{0,3}):){1,3}(:(0|[1-9a-f][0-9a-f]{0,3})){1,4}|((0|[1-9a-f][0-9a-f]{0,3}):){1,2}(:(0|[1-9a-f][0-9a-f]{0,3})){1,5}|(0|[1-9a-f][0-9a-f]{0,3}):(:(0|[1-9a-f][0-9a-f]{0,3})){1,6}|:((:(0|[1-9a-f][0-9a-f]{0,3})){1,7}|:)|((0|[1-9a-f][0-9a-f]{0,3}):){6}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|::((0|[1-9a-f][0-9a-f]{0,3}):){0,5}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){1}:((0|[1-9a-f][0-9a-f]{0,3}):){0,4}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){2}:((0|[1-9a-f][0-9a-f]{0,3}):){0,3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){3}:((0|[1-9a-f][0-9a-f]{0,3}):){0,2}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){4}:((0|[1-9a-f][0-9a-f]{0,3}):){0,1}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}|((0|[1-9a-f][0-9a-f]{0,3}):){5}:((0|[1-9a-f][0-9a-f]{0,3}):){0,0}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3})$"
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "ready" } }, "required": ["event"] },
      "then": {
        "required": ["admin", "policy"],
        "oneOf": [
          { "required": ["proxy"], "not": { "required": ["channel"] } },
          { "required": ["channel"], "not": { "required": ["proxy"] } }
        ]
      }
    }
  ]
}
