# typed: strict
# frozen_string_literal: true

# Rendered by maelys-release from this template: @VERSION@, @URL@ and
# @SHA256@ are replaced with the released source archive of one tag. The
# pinned dependencies below are copied from adapter/MAELYS_SYSTEM_PIN and
# adapter/MAELYS_CLI_PIN of that tag by scripts/render-homebrew-formula.sh.
class MaelysEgress < Formula
  desc "Policy-enforced HTTP CONNECT and SOCKS5 network mediator in pure C"
  homepage "https://github.com/maelys-dev/maelys-egress"
  url "@URL@"
  sha256 "@SHA256@"
  license "MPL-2.0"

  depends_on "python@3.13" => :build

  # Both formulas install libmaelys_sys and the Maelys System headers until
  # the tap carries one maelys-system formula they can depend on.
  conflicts_with "maelys-warden", because: "both install the Maelys System library and headers"

  resource "maelys-system" do
    url "https://github.com/maelys-dev/maelys-system.git",
        revision: "@SYSTEM_PIN@"
  end

  resource "maelys-cli" do
    url "https://github.com/maelys-dev/maelys-cli.git",
        tag:      "@CLI_TAG@",
        revision: "@CLI_PIN@"
  end

  def install
    # The Makefile verifies both dependency checkouts against the pins
    # recorded in adapter/, then installs libmaelys_egress, libmaelys_sys,
    # the headers, pkg-config files, the daemon and the documentation.
    ENV.deparallelize
    system_dir = buildpath/"vendor/maelys-system"
    cli_dir = buildpath/"vendor/maelys-cli"
    resource("maelys-system").stage system_dir
    resource("maelys-cli").stage cli_dir
    system "make", "install", "PREFIX=#{prefix}",
           "MAELYS_SYSTEM_DIR=#{system_dir}", "MAELYS_CLI_DIR=#{cli_dir}"
  end

  test do
    assert_equal "maelys-egress #{version}",
                 shell_output("#{bin}/maelys-egress version").strip
    (testpath/"smoke.c").write <<~EOS
      #include <maelys/egress.h>
      int main(void) { return MAELYS_EGRESS_ABI_VERSION == 2u ? 0 : 1; }
    EOS
    system ENV.cc, "-std=c11", "smoke.c", "-I#{include}", "-L#{lib}",
           "-lmaelys_egress", "-lmaelys_sys", "-pthread", "-o", "smoke"
    system "./smoke"
    (testpath/"egress.conf").write <<~EOS
      schema_version = 1
      listen = 127.0.0.1:0
      unauthenticated_loopback = true
      allow_private = 127.0.0.1:9
    EOS
    chmod 0600, testpath/"egress.conf"
    validate = "#{bin}/maelys-egress config validate --config #{testpath}/egress.conf"
    assert_match '"valid":true', shell_output("#{validate} --format json --compact")
  end
end
