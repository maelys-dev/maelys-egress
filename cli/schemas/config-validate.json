{
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "configurationSchemaVersion"],
  "properties": {
    "valid": {"type": "boolean"},
    "configurationSchemaVersion": {"const": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    }
  }
}
