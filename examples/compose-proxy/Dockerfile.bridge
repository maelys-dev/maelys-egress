FROM ubuntu:24.04

RUN apt-get -o Acquire::Retries=3 update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y \
      --no-install-recommends socat && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 bridge && \
    useradd --uid 10001 --gid bridge --no-create-home \
      --shell /usr/sbin/nologin bridge
COPY --chmod=0755 bridge.sh /usr/local/bin/maelys-proxy-bridge

# Compose runs Egress with this deployment UID too, so the bridge can enter the
# private socket directory and satisfies unix_peer=same-euid.
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/maelys-proxy-bridge"]
CMD []
