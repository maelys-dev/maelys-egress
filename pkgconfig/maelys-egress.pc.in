prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: maelys-egress
Description: Policy-enforced HTTP CONNECT and SOCKS5 network mediator
Version: @VERSION@
Libs: -L${libdir} -lmaelys_egress -pthread
Requires.private: maelys-sys >= @SYSTEM_VERSION@
Cflags: -I${includedir}
